[Unit]
Description=IO-Bound FastAPI Application
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Infrastructure-provisioning-and-operation-Resources-bound/apps/io-bound
ExecStart=/home/ubuntu/Infrastructure-provisioning-and-operation-Resources-bound/apps/io-bound/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8003
Restart=on-failure

[Install]
WantedBy=multi-user.target
